---
interface Project {
  name: string;
  description: string;
  status: "production" | "development";
  tech: string[];
  link: {
    url?: string;
    target?: string;
    title?: string;
    buttonLabel?: string;
  };
}

const projects: Project[] = [
  {
    name: "mkf",
    description:
      "FastAPI Project Scaffolder: A high-efficiency CLI tool to bootstrap modular, production-ready FastAPI applications with one command. Automates venv, git, and boilerplate.",
    status: "production",
    tech: ["Python", "FastAPI"],
    link: {
      url: "https://github.com/4nddrs/mkf",
    },
  },
  {
    name: "backend-Country",
    description:
      "Enterprise-grade Equestrian ERP: Scalable FastAPI backend featuring automated Telegram notifications, APScheduler tasks, and Supabase integration with Clean Architecture.",
    status: "production",
    tech: ["Python", "FastAPI", "PostgreSQL"],
    link: {
      url: "https://github.com/4nddrs/backend-Country",
    },
  },
  {
    name: "eppCheck",
    description:
      "AI-Driven Industrial Safety: Real-time YOLOv8 PPE detection system featuring asynchronous email alerts, incident evidence capture, and live analytics dashboard.",
    status: "production",
    tech: ["Python", "YOLOv8", "FastAPI"],
    link: {
      url: "https://github.com/4nddrs/eppCheck",
    },
  },
  {
    name: "smart-gym",
    description:
      "AI-powered Gym Management: Multi-service architecture (FastAPI) featuring real-time Facial Recognition, CompreFace integration, and a modern React frontend.",
    status: "production",
    tech: ["Python", "FastAPI", "React"],
    link: {
      url: "https://github.com/4nddrs/smart-gym",
    },
  },
  {
    name: "linux-config",
    description:
      "Modern Wayland Productivity: Minimalist Sway & Neovim (LazyVim) dotfiles. Keyboard-driven, high-performance Debian environment optimized for Python & Backend development.",
    status: "production",
    tech: ["Linux", "Neovim"],
    link: {
      url: "https://github.com/4nddrs/linux-config",
    },
  },
  {
    name: "scriptQR",
    description:
      "Cloud-synced CLI for Event Logistics: Automates ticket generation, QR code creation, and real-time Firebase Firestore management.",
    status: "production",
    tech: ["Python", "Firebase"],
    link: {
      url: "https://github.com/4nddrs/scriptQR",
    },
  },
];

const getTechColor = (tech: string) => {
  const colors: Record<string, string> = {
    Python: "#3b82f6",
    FastAPI: "#00d9a3",
    PostgreSQL: "#316192",
    YOLOv8: "#ff6b6b",
    React: "#61dafb",
    Linux: "#fcc624",
    Neovim: "#57a143",
    Firebase: "#ffca28",
  };
  return colors[tech] || "#6b7280";
};
---

<div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      projects.map((project) => (
        <div class="group relative flex flex-col justify-between items-start border border-gray-700/50 rounded-lg p-5 bg-[#0b0e14]/80 backdrop-blur-sm transition-all duration-300 hover:border-[#9381ff]/50 hover:shadow-[0_0_20px_rgba(147,129,255,0.15)]">
          {/* Status indicator */}
          <div class="absolute top-3 right-3">
            <span
              class={`relative flex h-3 w-3 ${project.status === "production" ? "" : "opacity-70"}`}
            >
              <span
                class={`animate-ping absolute inline-flex h-full w-full rounded-full ${project.status === "production" ? "bg-green-400" : "bg-yellow-400"} opacity-75`}
              />
              <span
                class={`relative inline-flex rounded-full h-3 w-3 ${project.status === "production" ? "bg-green-500" : "bg-yellow-500"}`}
              />
            </span>
          </div>

          <div class="w-full">
            <h3 class="text-xl font-semibold text-white mb-3 font-mono">
              {project.name}
            </h3>

            {/* Tech badges */}
            <div class="flex gap-2 mb-3 flex-wrap">
              {project.tech.map((tech) => (
                <span
                  class="text-xs px-2 py-1 rounded border font-mono"
                  style={`border-color: ${getTechColor(tech)}; color: ${getTechColor(tech)};`}
                >
                  {tech}
                </span>
              ))}
            </div>

            <p class="text-gray-400 text-sm leading-relaxed">
              {project.description}
            </p>
          </div>

          {project.link?.url ? (
            <a
              href={project.link.url}
              title={project.link.title || project.name}
              target={project.link.target || "_blank"}
              class="w-full px-4 py-2.5 mt-4 text-center border border-gray-600/50 rounded-lg hover:border-[#9381ff] transition-all duration-200 flex items-center justify-center gap-2 font-mono text-sm group-hover:bg-[#9381ff]/5"
            >
              <svg
                class="w-4 h-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              <span class="text-gray-300 group-hover:text-[#9381ff] transition-colors">
                git clone
              </span>
            </a>
          ) : null}
        </div>
      ))
    }
  </div>
</div>


